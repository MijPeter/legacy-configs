configname "Deathmatch"

init
{
	setl sv_pure "1"
	setl sv_cheats "0"
	setl sv_fps "40"
	setl sv_floodProtect "0"

	setl g_gameType "6"			// map voting: objective rules, next map voted at intermission
	setl g_doWarmup "0"			// no ready-up before bots start moving
	setl g_warmup "5"
	setl g_intermissionTime "30"	// cut short by deathmatch_bots.lua once everyone has voted

	setl g_friendlyFire "1"
	setl g_complaintlimit "0"
	setl g_teamForceBalance "0"
	setl g_noTeamSwitching "0"
	setl g_spectatorInactivity "0"
	setl g_alliedmaxlives "0"
	setl g_axismaxlives "0"
	
	
	setl g_medicChargeTime "45000"
	setl g_fieldopsChargeTime "35000"
	setl g_engineerChargeTime "30000"
	setl g_soldierChargeTime "30000"
	setl g_covertopschargetime "30000"
	

	// which is more reliable than picking their class via addbot
	setl team_maxFlamers "0"
	setl team_maxMachineguns "0"
	setl team_maxMortars "0"
	setl team_maxRockets "0"
	setl team_maxRiflegrenades "0"
	setl team_maxAirstrikes "0"
	setl team_maxArtillery "0"
	setl g_heavyWeaponRestriction "0"

	setl team_maxSoldiers "-1"
	setl team_maxMedics "0"
	setl team_maxEngineers "0"
	setl team_maxFieldops "0"
	setl team_maxCovertops "0"
	setl team_maxplayers "0"

	setl g_speed "320"
	setl g_gravity "800"
	setl g_fixedphysics "1"
	setl g_fixedphysicsfps "125"
	setl g_antilag "1"
	setl g_realHead "1"
	setl g_knockback "1000"

	setl g_dropAmmo "0"
	setl g_dropHealth "0"
	setl g_landminetimeout "0"

	setl g_mapscriptdirectory "mapscripts"
	setl g_mapConfigs ""

	setl lua_modules "luascripts/deathmatch_bots.lua luascripts/deathmatch_spawns.lua luascripts/deathmatch_squares.lua"

	setl omnibot_enable "1"

	// Map vote. Which maps are offered for how many players is set per map
	// in MAP_RULES (luascripts/deathmatch_bots.lua), which writes
	// mapvoteplayerscount.cfg for the mod to read.
	setl g_mapVoteFlags "16"	// 16: a passed "next map" vote ends the map and starts the map vote
	setl g_maxMapsVotedFor "10"
	setl g_minMapAge "0"		// only the map just played is left out of the vote
	// For now the vote only offers etl_adlernest and et_operation_b8 and their
	// variants, and the supply_last_stage and missile_first_stage variants
	// (variants are excluded by their own name, not their bsp's). Left out of
	// the vote:
	//  - no Omni-bot waypoints for them yet: Karsiah_te2, etl_frostbite,
	//    decay_sw
	//  - the stock maps, all but radar: oasis, battery, goldrush, railgun,
	//    fueldump
	//  - TODO: no spawn squares yet (deathmatch/<map>.txt): radar, supply,
	//    sw_goldrush_te. Take them out of this list once they have some.
	//  - missile_b3: has squares, but only missile_first_stage is played for now
	//  - played only when an admin loads them (rcon map ...): mp_sillyctf,
	//    te_valhalla, bremen_b3
	// Names are bsp names and case matters, so Karsiah is listed both ways.
	setl g_excludedMaps ":Karsiah_te2:karsiah_te2:etl_frostbite:decay_sw:oasis:battery:goldrush:railgun:fueldump:missile_b3:radar:supply:sw_goldrush_te:mp_sillyctf:te_valhalla:bremen_b3:"

	set nextmap "map_restart 0"	// used when no map is eligible for the vote

	// Idle players (no moving, jumping, leaning or shooting; looking around
	// doesn't count) are moved to spectators after g_inactivity seconds. The
	// on-screen countdown covers the last 10 of them.
	setl g_inactivity "20"

	setl g_allowVote "1"
	setl vote_allow_config "0"
	setl vote_allow_map "0"
	setl vote_allow_maprestart "0"
	setl vote_allow_bots "1"		// /callvote bots 0|1, see luascripts/deathmatch_bots.lua
	setl vote_allow_nextmap "1"	// ends the map, see g_mapVoteFlags
	// not for deathmatch
	setl vote_allow_gametype "0"
	setl vote_allow_warmupdamage "0"
	setl vote_allow_startmatch "0"	// needs the server's qagame
	setl vote_allow_antilag "0"
	setl vote_allow_balancedteams "0"
	setl vote_allow_swapteams "0"
	setl vote_allow_mutespecs "0"
	setl vote_allow_matchreset "0"
	setl vote_limit "99"
	setl vote_percent "51"

	setl skill_battlesense "-1"
	setl skill_engineer "-1"
	setl skill_medic "-1"
	setl skill_fieldops "-1"
	setl skill_lightweapons "-1"
	setl skill_soldier "-1"
	setl skill_covertops "-1"
	
	setl g_pronedelay "3"
	setl g_teamInfoUpdateRate "1000"


	set g_log "deathmatch.log"

	command "sv_cvarempty"
	command "sv_cvar cl_freelook EQ 1"
	command "sv_cvar cl_pitchspeed EQ 0"
	command "sv_cvar cl_yawspeed EQ 0"
	command "sv_cvar cl_timenudge EQ 0"

	command "sv_cvar cg_simpleItems IN 0 1"
	command "sv_cvar cg_visualEffects EQ 0"
	command "sv_cvar cg_drawEnvAwareness EQ 0"
	command "sv_cvar cg_fov IN 75 130"
	command "sv_cvar cg_shadows IN 0 1"
	command "sv_cvar cg_autoaction WB 1"
	command "sv_cvar cg_drawairstrikeplanes EQ 0"
	command "sv_cvar cg_reinforceWarningTime EQ 0"
	command "sv_cvar cg_reinforceWarningAudio EQ 0"

	command "sv_cvar rate EQ 90000"
	command "sv_cvar cl_maxpackets IN 100 125"
	command "sv_cvar snaps EQ 40"
	command "sv_cvar com_maxfps IN 125 500"

	command "sv_cvar m_pitch OUT -0.015 0.015"
	command "sv_cvar m_yaw IN -0.022 0.022"

	command "sv_cvar pmove_fixed EQ 0"
	command "sv_cvar pmove_msec EQ 8"

	command "sv_cvar r_ambientScale EQ 1.5"
	command "sv_cvar r_drawentities EQ 1"
	command "sv_cvar r_drawworld EQ 1"
	command "sv_cvar r_lightmap EQ 0"
	command "sv_cvar r_showtris EQ 0"
	command "sv_cvar r_znear EQ 3"
	command "sv_cvar r_allowextensions EQ 1"
	command "sv_cvar r_colorMipLevels EQ 0"
	command "sv_cvar r_depthbits EQ 24"
	command "sv_cvar r_detailtextures EQ 0"
	command "sv_cvar r_flares IN 0 1"
	command "sv_cvar r_subdivisions IN 1 20"
	command "sv_cvar r_lodcurveerror GE 60"
	command "sv_cvar r_wolffog EQ 0"
	command "sv_cvar r_zfar EQ 0"
	command "sv_cvar cg_drawCrosshairNames EQ 0"
	command "sv_cvar cg_drawCrosshairInfo EQ 0"

	// Bot population. "bot" is registered by Omni-bot, not the engine.
	// How many bots there are is up to deathmatch_bots.lua (MAP_RULES: per map
	// and number of active players), so Omni-bot's own balancing is off.
	// Bots go on AXIS (team 1), so join ALLIES.
	command "bot balanceteams 0"
	command "bot difficulty 4"
	command "bot moveskill 2"
}

map default
{
	set g_userTimeLimit "5"
	setl g_useralliedrespawntime "1"	// 1s respawn wave, NOT latched
	setl g_useraxisrespawntime "1"
	setl g_moverScale "1.0"
	setl team_maxLandmines "0"
	command "sv_cvar r_drawfoliage EQ 1"
	command "sv_cvar r_ambientScale EQ 1.5"
}

map radar
{
	command "sv_cvar r_drawfoliage EQ 0"	// no grass
}
