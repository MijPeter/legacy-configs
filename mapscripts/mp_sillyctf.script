axis_gold_flag
{
	death
	{
		trigger game_manager add_axis_goldbar
	}
}

allied_gold_flag
{
	death
	{
		trigger game_manager add_allies_goldbar
	}
}

axis_gold_crate
{
	spawn
	{
		accum 0 set 0 // gold counter
	}

	trigger stolen
	{
		setstate axis_gold_crate invisible
	}

	trigger secured
	{
		setstate axis_gold_crate default
	}

	trigger returned
	{
	}
}

deathmatch_removals
{
	spawn
	{
		// A spawn event runs as soon as its entity is created, while the rest
		// of the map is still being spawned: wait for every entity to exist.
		wait 50

		// --- Glass windows ---
		delete { model "*1" }                           // func_explosive type=glass 54x2x52 hp=50 window
		delete { model "*2" }                           // func_explosive type=glass 2x54x52 hp=50 window
		delete { model "*3" }                           // func_explosive type=glass 2x54x52 hp=50 window
		delete { model "*4" }                           // func_explosive type=glass 2x54x52 hp=50 window
		delete { model "*5" }                           // func_explosive type=glass 2x54x52 hp=50 window
		delete { model "*6" }                           // func_explosive type=glass 56x56x62 hp=50 window,window_edge
		delete { model "*7" }                           // func_explosive type=glass 56x56x62 hp=50 window,window_edge
		delete { model "*8" }                           // func_explosive type=glass 56x56x62 hp=50 window,window_edge
		delete { model "*9" }                           // func_explosive type=glass 56x56x62 hp=50 window,window_edge
		delete { model "*10" }                          // func_explosive type=glass 56x56x62 hp=50 window,window_edge
		delete { model "*11" }                          // func_explosive type=glass 56x56x62 hp=50 window,window_edge
		delete { model "*12" }                          // func_explosive type=glass 56x56x62 hp=50 window,window_edge
		delete { model "*13" }                          // func_explosive type=glass 56x56x62 hp=50 window,window_edge
		delete { model "*14" }                          // func_explosive type=glass 54x2x52 hp=50 window

		// --- Objectives ---
		delete { scriptname "allies_gold_crate" }       // team_CTF_blueflag
		delete { scriptname "axis_gold_crate" }         // team_CTF_redflag
		delete { scriptname "allied_gold_flag" }        // trigger_flagonly_multiple 128x80x32
		delete { scriptname "axis_gold_flag" }          // trigger_flagonly_multiple 132x80x32

		// --- Objective info and command map markers ---
		delete { targetname "axis_goldbar_toi" }        // trigger_objective_info track=the axis gold 96x224x96
		delete { targetname "allies_goldbar_toi" }      // trigger_objective_info track=the allied gold 96x224x96
		delete { scriptname "goldbars_axis_marker" }    // misc_commandmap_marker
		delete { scriptname "goldbars_allied_marker" }  // misc_commandmap_marker
		delete { targetname "axis_gold_storage_toi" }   // trigger_objective_info track=the axis gold storage 200x112x64
		delete { targetname "goldstorage_axis_marker" } // misc_commandmap_marker
		delete { targetname "allies_gold_storage_toi" } // trigger_objective_info track=the allied gold storage 192x112x64
		delete { targetname "goldstorage_allied_marker" } // misc_commandmap_marker
	}
}
